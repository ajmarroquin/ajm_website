{
  "templates_folder": "templates",
  "trigger_on_file_creation": true,
  "auto_jump_to_cursor": true,
  "enable_system_commands": false,
  "enable_folder_templates": true,
  "folder_templates": [
    { "folder": "people", "template": "templates/Mentee.md" },
    { "folder": "work", "template": "templates/Role.md" },
    { "folder": "projects", "template": "templates/Side project.md" },
    { "folder": "hobbies", "template": "templates/Hobby.md" },
    { "folder": "posts", "template": "templates/Post.md" }
  ]
}
